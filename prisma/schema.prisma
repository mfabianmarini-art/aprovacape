// CAPE Aprova — schema for the construction-approval platform.
// See chats/ and project/AprovaCAPE.dc.html in the design handoff bundle for the source spec.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN_CAPE
  CAPE_ANALISTA
  SINDICO
  PROPRIETARIO
  RESPONSAVEL_TECNICO
}

enum VinculoStatus {
  PENDENTE
  APROVADO
  RECUSADO
}

enum Conselho {
  CREA
  CAU
}

// O histórico era só texto livre. O relatório precisa contar o que a CAPE fez num
// período, e contar por texto seria refém da redação de cada mensagem.
enum EventoTipo {
  OUTRO
  SOLICITACAO_ENVIADA
  DOCUMENTACAO_DEVOLVIDA
  REENVIO_RECEBIDO
  CHECKLIST_DEVOLVIDO
  PROJETO_APROVADO
  ALVARA_ENVIADO
  ALVARA_ACEITO
  ALVARA_RECUSADO
  IRREGULARIDADE_REGISTRADA
  IRREGULARIDADE_REGULARIZADA
  OBRA_CONCLUIDA
  // Troca de responsável pelo lote aprovada pela CAPE.
  VINCULO_SUBSTITUIDO
  // Proprietário da matrícula corrigido no cadastro do lote pela CAPE.
  TITULAR_ALTERADO
}

enum IrregularidadeTipo {
  DIVERGENCIA_PROJETO
  RECUO_OU_GABARITO
  OBRA_SEM_APROVACAO
  CANTEIRO_E_LIMPEZA
  HORARIO_OU_RUIDO
  DANO_A_AREA_COMUM
  OUTRA
}

enum SolicitacaoTipo {
  OBRA_NOVA
  REFORMA
  AMPLIACAO
  DEMOLICAO
  MURO
  PAISAGISMO
}

// Mirrors the ST map in the prototype's script block.
enum SolicitacaoStatus {
  RASCUNHO
  ENVIADA
  ANALISE
  COMPLEMENTO
  APROVADA
  RESSALVAS
  REPROVADA
  // Alvará da Prefeitura enviado pelo proprietário, aguardando conferência da CAPE.
  // Só a aceitação libera o início da obra.
  ALVARA_CONFERENCIA
  EXECUCAO
  CONCLUIDA
}

enum DocumentoTipo {
  // Projeto arquitetônico em PDF, para leitura.
  PROJETO_ARQUITETONICO
  // O mesmo projeto em DWG (ou .zip com vários DWG), para a CAPE conferir no CAD.
  PROJETO_ARQUITETONICO_DWG
  ART_RRT_PROJETO
  ART_RRT_EXECUCAO
  MEMORIAL_DESCRITIVO
  PROJETO_PAISAGISTICO
  CAPA_IPTU
  MATRICULA
  LEVANTAMENTO_PLANIALTIMETRICO
  // Não obrigatório, como o projeto paisagístico (ver DOC_OPCIONAIS).
  OUTROS
}

enum ChecklistItemStatus {
  PENDENTE
  APROVADO
  REPROVADO
  // Item que não cabe nesta obra (ex.: piscina numa reforma de fachada). Conta como
  // decidido para o parecer e não gera pendência.
  NAO_SE_APLICA
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  cpf           String        @unique
  birthDate     DateTime
  phone         String
  passwordHash  String
  role          Role

  // Freio de força bruta: 5 falhas consecutivas bloqueiam o login por 15 minutos.
  tentativasLogin Int       @default(0)
  bloqueadoAte    DateTime?
  // Última troca de senha. Sessões (JWT) abertas antes disto deixam de valer — é assim que
  // a redefinição derruba quem estava logado com a senha antiga.
  senhaAlteradaEm DateTime?

  // Habilitação profissional (RT e equipe técnica da CAPE): conselho, número e UF emissora.
  conselho       Conselho?
  registroNumero String?
  registroUf     String?
  createdAt     DateTime      @default(now())

  // Self-registration (proprietário / RT) vínculo review, done in parallel with access.
  vinculoStatus     VinculoStatus?
  vinculoLoteId     String?
  vinculoLote       Lote?          @relation("VinculoLote", fields: [vinculoLoteId], references: [id])
  // Proprietário comprova pela matrícula do lote; o RT anexa a
  // autorização assinada pelo proprietário.
  vinculoComprovacao String?
  vinculoArquivoNome     String?
  vinculoArquivoCaminho  String?
  vinculoArquivoTamanho  Int?
  // Dados do proprietário, declarados pelo RT ao pedir vínculo. A autorização é um
  // arquivo assinado; sem saber quem assinou, a CAPE não tem contra quem conferi-lo.
  vinculoPropNome        String?
  vinculoPropCpf         String?
  vinculoPropEmail       String?
  vinculoPropTelefone    String?
  // Quando o pedido atual foi feito. Usuário já cadastrado pede vínculo com outro lote
  // reaproveitando estes campos (um pedido por vez), então createdAt não serve mais.
  vinculoSolicitadoEm    DateTime?
  vinculoRevisadoPorId String?
  vinculoRevisadoEm    DateTime?

  lotesComoProprietario Lote[]        @relation("LoteProprietario")
  lotesComoRT           Lote[]        @relation("LoteRT")
  solicitacoesCriadas   Solicitacao[] @relation("SolicitacaoCriadaPor")
  historicoEventos      HistoricoEvento[]
  irregularidadesRegistradas Irregularidade[] @relation("IrregularidadeRegistradaPor")
  empreendimentosSindico Empreendimento[] @relation("EmpreendimentoSindico")
  documentosTecnicosEnviados DocumentoTecnico[] @relation("DocumentoTecnicoEnviadoPor")
  lotesTitularAtualizados    Lote[]             @relation("LoteTitularAtualizadoPor")
  devolutivasTecnicas        DevolutivaTecnica[] @relation("DevolutivaTecnicaAutor")
  redefinicoesSenha          RedefinicaoSenha[]
  arquivosEnviados           Arquivo[]          @relation("ArquivoEnviadoPor")
  acessosArquivos            AcessoArquivo[]

  @@index([role])
}

model Empreendimento {
  id                String   @id @default(cuid())
  nome              String
  cidade            String
  uf                String
  numQuadras        Int
  taxaAnaliseCent   Int      // R$ in cents
  prazoDias         Int      @default(10)
  reenviosSemTaxa   Int      @default(3)
  taxaVisitaCent    Int      @default(0)
  prazoComplementoDias Int   @default(180)
  plantaImageUrl    String?
  // Contrato da CAPE com o condomínio. Rescindido, toda a documentação continua
  // disponível por 30 dias (cláusula contratual); só depois disso os arquivos podem ser
  // excluídos, por ação explícita do admin (arquivosExcluidosEm).
  contratoRescindidoEm DateTime?
  arquivosExcluidosEm  DateTime?
  sindicoId         String?
  sindico           User?    @relation("EmpreendimentoSindico", fields: [sindicoId], references: [id])
  createdAt         DateTime @default(now())

  quadras    Quadra[]
  lotes      Lote[]
  categorias ChecklistCategoria[]
  documentosTecnicos DocumentoTecnico[]
  arquivos           Arquivo[]

  @@index([sindicoId])
}

model Quadra {
  id               String   @id @default(cuid())
  empreendimentoId String
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id])
  nome             String   // "Q1"
  totalLotes       Int

  lotes Lote[]

  @@unique([empreendimentoId, nome])
}

model Lote {
  id               String   @id @default(cuid())
  empreendimentoId String
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id])
  quadraId         String
  quadra           Quadra   @relation(fields: [quadraId], references: [id])
  numero           String   // "04"
  // Endereço e área são preenchidos pelo proprietário/RT na primeira solicitação de obra
  // do lote, não pelo gestor CAPE no cadastro — por isso ficam nulos até lá.
  rua              String?
  areaM2           Float?

  // Position of the pin over the planta image, in percent (0-100).
  posX Float?
  posY Float?

  // Proprietário conforme a matrícula do lote, mantido pela CAPE. Independe de haver
  // conta na plataforma: é este dado que a aprovação de vínculo compara. `proprietarioId`
  // responde outra pergunta — qual conta acessa a plataforma por este lote.
  titularNome            String?
  titularCpf             String?
  titularAtualizadoEm    DateTime?
  titularAtualizadoPorId String?
  titularAtualizadoPor   User?     @relation("LoteTitularAtualizadoPor", fields: [titularAtualizadoPorId], references: [id])
  proprietarioId String?
  proprietario   User?   @relation("LoteProprietario", fields: [proprietarioId], references: [id])
  rtId           String?
  rt             User?   @relation("LoteRT", fields: [rtId], references: [id])

  vinculosPendentes User[]        @relation("VinculoLote")
  solicitacoes      Solicitacao[]

  @@unique([empreendimentoId, quadraId, numero])
  @@index([rtId])
  @@index([proprietarioId])
}

model ChecklistCategoria {
  id               String   @id @default(cuid())
  empreendimentoId String
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id])
  nome             String
  ordem            Int      @default(0)

  itens ChecklistItem[]
}

model ChecklistItem {
  id          String   @id @default(cuid())
  categoriaId String
  categoria   ChecklistCategoria @relation(fields: [categoriaId], references: [id])
  texto       String
  referencia  String
  ordem       Int      @default(0)

  resultados ChecklistResultado[]
}

model Solicitacao {
  id               String            @id @default(cuid())
  protocolo        String            @unique // "SOL-2026-041"
  loteId           String
  lote             Lote              @relation(fields: [loteId], references: [id])
  tipo             SolicitacaoTipo
  // Chamada de "área de intervenção" na UI: cobre também obras que não constroem área
  // nova (demolição, muro, paisagismo), então "área construída" deixou de fazer sentido.
  areaIntervencao  Float
  descricao        String
  status           SolicitacaoStatus @default(ENVIADA)
  prazoDias        Int
  // Só o ciclo do check-list conta como reenvio: devolução na validação documental é
  // conferência de forma, não reanálise técnica. Marca de qual fase veio a devolução,
  // para `reenviarComplementacaoAction` saber se incrementa ao receber de volta.
  reenvios         Int               @default(0)
  devolvidaNoChecklist Boolean       @default(false)
  pago             Boolean           @default(false)
  criadoPorId      String
  criadoPor        User              @relation("SolicitacaoCriadaPor", fields: [criadoPorId], references: [id])
  // RT do projeto.
  responsavelTecnicoNome String
  responsavelTecnicoRegistro String
  responsavelTecnicoEmail String
  // RT da execução — pode ser outro profissional que o do projeto.
  rtExecucaoNome     String @default("")
  rtExecucaoRegistro String @default("")
  rtExecucaoEmail    String @default("")
  documentacaoValidada Boolean       @default(false)

  // Alvará de execução da Prefeitura. O arquivo vive no Blob como os demais; o status
  // anterior é guardado para a recusa devolver a solicitação ao ponto certo (APROVADA
  // ou RESSALVAS), sem achatar a distinção entre os dois.
  alvaraNome       String?
  alvaraCaminho    String?
  alvaraTamanho    Int?
  alvaraEnviadoEm  DateTime?
  alvaraRecusa     String?
  concluidaEm      DateTime?
  statusAntesAlvara SolicitacaoStatus?

  // Acompanhamento pelo proprietário em /acompanhar, sem conta: protocolo + esta senha,
  // gerada no envio e repassada pelo RT. Cifrada (não hash) para o RT poder consultá-la
  // de novo em Meus requerimentos; trocar AUTH_SECRET a torna ilegível e o RT gera outra.
  acompanhamentoSenhaCifrada String?
  acompanhamentoTentativas   Int       @default(0)
  acompanhamentoBloqueadoAte DateTime?
  // Para onde vão protocolo e senha. Informado pelo RT no envio; nulo nas solicitações
  // anteriores a isso, até o RT reenviar o acesso.
  proprietarioEmail          String?
  // Último envio bem-sucedido do acesso ao proprietário. Nulo: nunca saiu por e-mail
  // (Resend não configurado, ou falha) e o RT precisa repassar a senha.
  acompanhamentoEnviadoEm    DateTime?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  prazoAnaliseEm   DateTime?

  documentos      SolicitacaoDocumento[]
  resultados      ChecklistResultado[]
  historico       HistoricoEvento[]
  irregularidades Irregularidade[]
  devolutivas     DevolutivaTecnica[]

  // Consultas mais frequentes: solicitações de um lote, e filas/contagens por status.
  @@index([loteId])
  @@index([status])
  arquivos        Arquivo[]
}

// O que a CAPE manda ao RT junto com um parecer do check-list: comentários gerais e/ou o
// arquivo com os apontamentos (DWG marcado). Opcional; um registro por parecer emitido.
model DevolutivaTecnica {
  id             String      @id @default(cuid())
  solicitacaoId  String
  solicitacao    Solicitacao @relation(fields: [solicitacaoId], references: [id])
  comentario     String?
  arquivoNome    String?
  arquivoCaminho String?
  arquivoTamanho Int?
  autorId        String
  autor          User        @relation("DevolutivaTecnicaAutor", fields: [autorId], references: [id])
  createdAt      DateTime    @default(now())

  @@index([solicitacaoId, createdAt])
}

model SolicitacaoDocumento {
  id             String        @id @default(cuid())
  solicitacaoId  String
  solicitacao    Solicitacao   @relation(fields: [solicitacaoId], references: [id])
  tipo           DocumentoTipo
  nomeArquivo    String
  caminhoArquivo String
  tamanhoBytes   Int
  validado       Boolean       @default(false)
  // O que impede a validação deste documento, escrito pelo analista e lido pelo
  // proprietário/RT em /requerimentos quando a solicitação volta para complementação.
  observacao     String?
  uploadedAt     DateTime      @default(now())

  @@unique([solicitacaoId, tipo])
}

model ChecklistResultado {
  id            String              @id @default(cuid())
  solicitacaoId String
  solicitacao   Solicitacao         @relation(fields: [solicitacaoId], references: [id])
  itemId        String
  item          ChecklistItem       @relation(fields: [itemId], references: [id])
  status        ChecklistItemStatus @default(PENDENTE)
  travado       Boolean             @default(false)
  // O que não atendeu a norma neste item. Sobrevive à devolução: o item volta a
  // PENDENTE para o próximo ciclo, mas o motivo continua à vista de quem vai corrigir.
  observacao    String?
  avaliadoEm    DateTime?

  @@unique([solicitacaoId, itemId])
}

model HistoricoEvento {
  id            String      @id @default(cuid())
  solicitacaoId String
  solicitacao   Solicitacao @relation(fields: [solicitacaoId], references: [id])
  tipo          EventoTipo  @default(OUTRO)
  texto         String
  cor           String      // hex used for the timeline dot, matches status semantics
  autorId       String?
  autor         User?       @relation(fields: [autorId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([tipo, createdAt])
  // A linha do tempo de cada solicitação é lida a cada abertura da análise e do card.
  @@index([solicitacaoId, createdAt])
}

// Irregularidade constatada na obra pela CAPE. Fica visível ao síndico, ao proprietário
// e ao RT — é o registro que sustenta a notificação.
model Irregularidade {
  id              String             @id @default(cuid())
  solicitacaoId   String
  solicitacao     Solicitacao        @relation(fields: [solicitacaoId], references: [id])
  tipo            IrregularidadeTipo
  descricao       String
  registradaPorId String
  registradaPor   User               @relation("IrregularidadeRegistradaPor", fields: [registradaPorId], references: [id])
  regularizadaEm  DateTime?
  createdAt       DateTime           @default(now())

  evidencias IrregularidadeEvidencia[]

  @@index([createdAt])
  @@index([solicitacaoId])
}

model IrregularidadeEvidencia {
  id               String         @id @default(cuid())
  irregularidadeId String
  irregularidade   Irregularidade @relation(fields: [irregularidadeId], references: [id], onDelete: Cascade)
  nomeArquivo      String
  caminhoArquivo   String
  tamanhoBytes     Int

  @@index([irregularidadeId])
}

enum DocumentoTecnicoCategoria {
  MANUAL_PROPRIETARIO
  CONVENCAO_CONDOMINIO
  REGULAMENTO
  OUTRO
}

// Material de referência do empreendimento (manual do proprietário, convenção do
// condomínio, regulamentos etc.) — enviado por gestores CAPE ou pelo síndico, consultado
// por proprietários e responsáveis técnicos para elaborar o projeto de obra.
model DocumentoTecnico {
  id               String                    @id @default(cuid())
  empreendimentoId String
  empreendimento   Empreendimento            @relation(fields: [empreendimentoId], references: [id])
  categoria        DocumentoTecnicoCategoria @default(OUTRO)
  titulo           String
  descricao        String?
  nomeArquivo      String
  caminhoArquivo   String
  tamanhoBytes     Int
  enviadoPorId     String
  enviadoPor       User                      @relation("DocumentoTecnicoEnviadoPor", fields: [enviadoPorId], references: [id])
  createdAt        DateTime                  @default(now())
}

// Pedido de "esqueci minha senha". Do token só fica o hash (SHA-256): quem lê o banco não
// consegue usar um link pendente. Vale 30 minutos e uma vez; pedido novo apaga os anteriores.
model RedefinicaoSenha {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// Contador de tentativas por origem (limite-taxa.ts). A chave é "ação:HMAC(ip)" — o IP em
// si não é gravado. Linhas vencidas são apagadas pela rotina diária de manutenção.
model LimiteTaxa {
  chave    String   @id
  inicio   DateTime
  contagem Int
}

enum ArquivoCategoria {
  DOCUMENTO          // documento da solicitação (check-list)
  DEVOLUTIVA         // apontamentos da CAPE ao RT
  ALVARA             // alvará de execução
  EVIDENCIA          // evidência de irregularidade
  VINCULO            // autorização do proprietário para o vínculo do RT
  DOCUMENTO_TECNICO  // documentos técnicos do empreendimento
  PLANTA             // planta do loteamento
  RECUPERADO         // arquivo anterior ao inventário, adotado sem metadados
}

// Inventário de tudo o que está no Blob. Por contrato, a documentação fica disponível
// enquanto durar o contrato com o condomínio e por 30 dias após a rescisão: nenhuma linha
// daqui é apagada e substituir um documento só marca a versão anterior (substituidoEm) —
// ela continua acessível. Também é o que separa arquivo registrado de upload abandonado
// na limpeza (manutencao.ts) e o que o backup copia.
model Arquivo {
  id               String           @id @default(cuid())
  caminho          String           @unique
  nome             String
  tamanho          Int
  // SHA-256 calculado no navegador: detecta reenvio de arquivo idêntico sem subir de novo.
  hash             String?
  categoria        ArquivoCategoria
  documentoTipo    DocumentoTipo?
  // SetNull: um rascunho cancelado some, o arquivo que ele tinha continua no inventário.
  solicitacaoId    String?
  solicitacao      Solicitacao?     @relation(fields: [solicitacaoId], references: [id], onDelete: SetNull)
  empreendimentoId String?
  empreendimento   Empreendimento?  @relation(fields: [empreendimentoId], references: [id], onDelete: SetNull)
  // Dono do arquivo quando não é de uma solicitação (autorização de vínculo).
  usuarioId        String?
  enviadoPorId     String?
  enviadoPor       User?            @relation("ArquivoEnviadoPor", fields: [enviadoPorId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  // Deixou de ser a versão em uso (documento substituído, alvará recusado, documento
  // técnico retirado da lista). Continua guardado e acessível.
  substituidoEm    DateTime?
  // Só depois de 30 dias da rescisão, por ação do admin: o blob é apagado, a linha fica
  // como registro do que existiu.
  excluidoEm       DateTime?

  acessos AcessoArquivo[]

  @@index([solicitacaoId, createdAt])
  @@index([empreendimentoId])
  @@index([hash])
}

// Quem abriu qual arquivo e quando — trilha de auditoria de acesso a documentos com dados
// pessoais (LGPD). Gravado depois da resposta, sem atrasar o download.
model AcessoArquivo {
  id        String   @id @default(cuid())
  arquivoId String
  arquivo   Arquivo  @relation(fields: [arquivoId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([arquivoId, createdAt])
  @@index([usuarioId, createdAt])
}
