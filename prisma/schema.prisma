// CAPE Aprova — schema for the construction-approval platform.
// See chats/ and project/AprovaCAPE.dc.html in the design handoff bundle for the source spec.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN_CAPE
  CAPE_ANALISTA
  SINDICO
  PROPRIETARIO
  RESPONSAVEL_TECNICO
}

enum VinculoStatus {
  PENDENTE
  APROVADO
  RECUSADO
}

enum Conselho {
  CREA
  CAU
}

// O histórico era só texto livre. O relatório precisa contar o que a CAPE fez num
// período, e contar por texto seria refém da redação de cada mensagem.
enum EventoTipo {
  OUTRO
  SOLICITACAO_ENVIADA
  DOCUMENTACAO_DEVOLVIDA
  REENVIO_RECEBIDO
  CHECKLIST_DEVOLVIDO
  PROJETO_APROVADO
  ALVARA_ENVIADO
  ALVARA_ACEITO
  ALVARA_RECUSADO
  IRREGULARIDADE_REGISTRADA
  IRREGULARIDADE_REGULARIZADA
  OBRA_CONCLUIDA
}

enum IrregularidadeTipo {
  DIVERGENCIA_PROJETO
  RECUO_OU_GABARITO
  OBRA_SEM_APROVACAO
  CANTEIRO_E_LIMPEZA
  HORARIO_OU_RUIDO
  DANO_A_AREA_COMUM
  OUTRA
}

enum SolicitacaoTipo {
  OBRA_NOVA
  REFORMA
  AMPLIACAO
  DEMOLICAO
  MURO
  PAISAGISMO
}

// Mirrors the ST map in the prototype's script block.
enum SolicitacaoStatus {
  RASCUNHO
  ENVIADA
  ANALISE
  COMPLEMENTO
  APROVADA
  RESSALVAS
  REPROVADA
  // Alvará da Prefeitura enviado pelo proprietário, aguardando conferência da CAPE.
  // Só a aceitação libera o início da obra.
  ALVARA_CONFERENCIA
  EXECUCAO
  CONCLUIDA
}

enum DocumentoTipo {
  PROJETO_ARQUITETONICO
  ART_RRT_PROJETO
  ART_RRT_EXECUCAO
  MEMORIAL_DESCRITIVO
  PROJETO_PAISAGISTICO
  CAPA_IPTU
  MATRICULA
  LEVANTAMENTO_PLANIALTIMETRICO
  // Único documento não obrigatório do check-list.
  OUTROS
}

enum ChecklistItemStatus {
  PENDENTE
  APROVADO
  REPROVADO
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  cpf           String        @unique
  birthDate     DateTime
  phone         String
  passwordHash  String
  role          Role

  // Freio de força bruta: 5 falhas consecutivas bloqueiam o login por 15 minutos.
  tentativasLogin Int       @default(0)
  bloqueadoAte    DateTime?

  // Habilitação profissional (RT e equipe técnica da CAPE): conselho, número e UF emissora.
  conselho       Conselho?
  registroNumero String?
  registroUf     String?
  createdAt     DateTime      @default(now())

  // Self-registration (proprietário / RT) vínculo review, done in parallel with access.
  vinculoStatus     VinculoStatus?
  vinculoLoteId     String?
  vinculoLote       Lote?          @relation("VinculoLote", fields: [vinculoLoteId], references: [id])
  // Proprietário comprova por texto (matrícula/código de convite); o RT anexa a
  // autorização assinada pelo proprietário.
  vinculoComprovacao String?
  vinculoArquivoNome     String?
  vinculoArquivoCaminho  String?
  vinculoArquivoTamanho  Int?
  vinculoRevisadoPorId String?
  vinculoRevisadoEm    DateTime?

  lotesComoProprietario Lote[]        @relation("LoteProprietario")
  lotesComoRT           Lote[]        @relation("LoteRT")
  solicitacoesCriadas   Solicitacao[] @relation("SolicitacaoCriadaPor")
  historicoEventos      HistoricoEvento[]
  irregularidadesRegistradas Irregularidade[] @relation("IrregularidadeRegistradaPor")
  empreendimentosSindico Empreendimento[] @relation("EmpreendimentoSindico")
  documentosTecnicosEnviados DocumentoTecnico[] @relation("DocumentoTecnicoEnviadoPor")

  @@index([role])
}

model Empreendimento {
  id                String   @id @default(cuid())
  nome              String
  cidade            String
  uf                String
  numQuadras        Int
  taxaAnaliseCent   Int      // R$ in cents
  prazoDias         Int      @default(10)
  reenviosSemTaxa   Int      @default(3)
  taxaVisitaCent    Int      @default(0)
  prazoComplementoDias Int   @default(180)
  plantaImageUrl    String?
  sindicoId         String?
  sindico           User?    @relation("EmpreendimentoSindico", fields: [sindicoId], references: [id])
  createdAt         DateTime @default(now())

  quadras    Quadra[]
  lotes      Lote[]
  categorias ChecklistCategoria[]
  documentosTecnicos DocumentoTecnico[]
}

model Quadra {
  id               String   @id @default(cuid())
  empreendimentoId String
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id])
  nome             String   // "Q1"
  totalLotes       Int

  lotes Lote[]

  @@unique([empreendimentoId, nome])
}

model Lote {
  id               String   @id @default(cuid())
  empreendimentoId String
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id])
  quadraId         String
  quadra           Quadra   @relation(fields: [quadraId], references: [id])
  numero           String   // "04"
  // Endereço e área são preenchidos pelo proprietário/RT na primeira solicitação de obra
  // do lote, não pelo gestor CAPE no cadastro — por isso ficam nulos até lá.
  rua              String?
  areaM2           Float?

  // Position of the pin over the planta image, in percent (0-100).
  posX Float?
  posY Float?

  proprietarioId String?
  proprietario   User?   @relation("LoteProprietario", fields: [proprietarioId], references: [id])
  rtId           String?
  rt             User?   @relation("LoteRT", fields: [rtId], references: [id])

  vinculosPendentes User[]        @relation("VinculoLote")
  solicitacoes      Solicitacao[]

  @@unique([empreendimentoId, quadraId, numero])
}

model ChecklistCategoria {
  id               String   @id @default(cuid())
  empreendimentoId String
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id])
  nome             String
  ordem            Int      @default(0)

  itens ChecklistItem[]
}

model ChecklistItem {
  id          String   @id @default(cuid())
  categoriaId String
  categoria   ChecklistCategoria @relation(fields: [categoriaId], references: [id])
  texto       String
  referencia  String
  ordem       Int      @default(0)

  resultados ChecklistResultado[]
}

model Solicitacao {
  id               String            @id @default(cuid())
  protocolo        String            @unique // "SOL-2026-041"
  loteId           String
  lote             Lote              @relation(fields: [loteId], references: [id])
  tipo             SolicitacaoTipo
  // Chamada de "área de intervenção" na UI: cobre também obras que não constroem área
  // nova (demolição, muro, paisagismo), então "área construída" deixou de fazer sentido.
  areaIntervencao  Float
  descricao        String
  status           SolicitacaoStatus @default(ENVIADA)
  prazoDias        Int
  // Só o ciclo do check-list conta como reenvio: devolução na validação documental é
  // conferência de forma, não reanálise técnica. Marca de qual fase veio a devolução,
  // para `reenviarComplementacaoAction` saber se incrementa ao receber de volta.
  reenvios         Int               @default(0)
  devolvidaNoChecklist Boolean       @default(false)
  pago             Boolean           @default(false)
  criadoPorId      String
  criadoPor        User              @relation("SolicitacaoCriadaPor", fields: [criadoPorId], references: [id])
  // RT do projeto.
  responsavelTecnicoNome String
  responsavelTecnicoRegistro String
  responsavelTecnicoEmail String
  // RT da execução — pode ser outro profissional que o do projeto.
  rtExecucaoNome     String @default("")
  rtExecucaoRegistro String @default("")
  rtExecucaoEmail    String @default("")
  documentacaoValidada Boolean       @default(false)

  // Alvará de execução da Prefeitura. O arquivo vive no Blob como os demais; o status
  // anterior é guardado para a recusa devolver a solicitação ao ponto certo (APROVADA
  // ou RESSALVAS), sem achatar a distinção entre os dois.
  alvaraNome       String?
  alvaraCaminho    String?
  alvaraTamanho    Int?
  alvaraEnviadoEm  DateTime?
  alvaraRecusa     String?
  concluidaEm      DateTime?
  statusAntesAlvara SolicitacaoStatus?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  prazoAnaliseEm   DateTime?

  documentos      SolicitacaoDocumento[]
  resultados      ChecklistResultado[]
  historico       HistoricoEvento[]
  irregularidades Irregularidade[]
}

model SolicitacaoDocumento {
  id             String        @id @default(cuid())
  solicitacaoId  String
  solicitacao    Solicitacao   @relation(fields: [solicitacaoId], references: [id])
  tipo           DocumentoTipo
  nomeArquivo    String
  caminhoArquivo String
  tamanhoBytes   Int
  validado       Boolean       @default(false)
  // O que impede a validação deste documento, escrito pelo analista e lido pelo
  // proprietário/RT em /requerimentos quando a solicitação volta para complementação.
  observacao     String?
  uploadedAt     DateTime      @default(now())

  @@unique([solicitacaoId, tipo])
}

model ChecklistResultado {
  id            String              @id @default(cuid())
  solicitacaoId String
  solicitacao   Solicitacao         @relation(fields: [solicitacaoId], references: [id])
  itemId        String
  item          ChecklistItem       @relation(fields: [itemId], references: [id])
  status        ChecklistItemStatus @default(PENDENTE)
  travado       Boolean             @default(false)
  // O que não atendeu a norma neste item. Sobrevive à devolução: o item volta a
  // PENDENTE para o próximo ciclo, mas o motivo continua à vista de quem vai corrigir.
  observacao    String?
  avaliadoEm    DateTime?

  @@unique([solicitacaoId, itemId])
}

model HistoricoEvento {
  id            String      @id @default(cuid())
  solicitacaoId String
  solicitacao   Solicitacao @relation(fields: [solicitacaoId], references: [id])
  tipo          EventoTipo  @default(OUTRO)
  texto         String
  cor           String      // hex used for the timeline dot, matches status semantics
  autorId       String?
  autor         User?       @relation(fields: [autorId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([tipo, createdAt])
}

// Irregularidade constatada na obra pela CAPE. Fica visível ao síndico, ao proprietário
// e ao RT — é o registro que sustenta a notificação.
model Irregularidade {
  id              String             @id @default(cuid())
  solicitacaoId   String
  solicitacao     Solicitacao        @relation(fields: [solicitacaoId], references: [id])
  tipo            IrregularidadeTipo
  descricao       String
  registradaPorId String
  registradaPor   User               @relation("IrregularidadeRegistradaPor", fields: [registradaPorId], references: [id])
  regularizadaEm  DateTime?
  createdAt       DateTime           @default(now())

  evidencias IrregularidadeEvidencia[]

  @@index([createdAt])
}

model IrregularidadeEvidencia {
  id               String         @id @default(cuid())
  irregularidadeId String
  irregularidade   Irregularidade @relation(fields: [irregularidadeId], references: [id], onDelete: Cascade)
  nomeArquivo      String
  caminhoArquivo   String
  tamanhoBytes     Int
}

enum DocumentoTecnicoCategoria {
  MANUAL_PROPRIETARIO
  CONVENCAO_CONDOMINIO
  REGULAMENTO
  OUTRO
}

// Material de referência do empreendimento (manual do proprietário, convenção do
// condomínio, regulamentos etc.) — enviado por gestores CAPE ou pelo síndico, consultado
// por proprietários e responsáveis técnicos para elaborar o projeto de obra.
model DocumentoTecnico {
  id               String                    @id @default(cuid())
  empreendimentoId String
  empreendimento   Empreendimento            @relation(fields: [empreendimentoId], references: [id])
  categoria        DocumentoTecnicoCategoria @default(OUTRO)
  titulo           String
  descricao        String?
  nomeArquivo      String
  caminhoArquivo   String
  tamanhoBytes     Int
  enviadoPorId     String
  enviadoPor       User                      @relation("DocumentoTecnicoEnviadoPor", fields: [enviadoPorId], references: [id])
  createdAt        DateTime                  @default(now())
}
